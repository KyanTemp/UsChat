@model UsChat.ASP.Models.User.UserViewModel
@{
    ViewBag.Title = "Login";
}
<div class="container d-flex justify-content-center align-items-center align-middle" style="height:80vh;">
    <div class="container d-flex justify-content-center align-items-center align-middle">
        <div class="card p-4" style="min-width: 300px; max-width: 400px; background-color: #e6e6e6;">
            <h3 class="text-center mb-4">Log In</h3>
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.ErrorMessage
                </div>
            }
            <form method="post" asp-controller="Login" asp-action="Login">
                <div class="form-group mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="Email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-dark">Log In</button>
                </div>
            </form>

            @Html.ActionLink("Maak je account", "Register", "Login")
        </div>
    </div>
</div>